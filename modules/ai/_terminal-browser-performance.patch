diff --git a/browser/dist/main.js b/browser/dist/main.js
--- a/browser/dist/main.js
+++ b/browser/dist/main.js
@@ -44517,13 +44517,25 @@ var UNCAPPED = "uncapped";
-function maxFps(value, displayHz2) {
-  if (value === DISPLAY_FPS) return displayHz2;
+function maxFps(value, displayHz2, sessionEnv = {}) {
+  if (value === DISPLAY_FPS) {
+    // Electron can report 0 Hz on Wayland/headless displays. Zero means
+    // uncapped to Pixel, not "use the display rate".
+    const hz = Number.isFinite(displayHz2) && displayHz2 > 0 ? displayHz2 : 60;
+    return sessionEnv.HERDR_PANE_ID ? Math.min(hz, 60) : hz;
+  }
   if (value === UNCAPPED) return 0;
   return Number(value);
 }
-function renderEnv(get) {
+function renderEnv(get, sessionEnv = {}) {
   const env = {};
   const presenter = get("render.presenter");
   if (presenter !== AUTO) env.TERMINAL_BROWSER_PRESENT = presenter;
+  else if (sessionEnv.HERDR_PANE_ID && !sessionEnv.TERMINAL_BROWSER_PRESENT)
+    env.TERMINAL_BROWSER_PRESENT = "full";
   const transport = get("render.transport");
   if (transport !== AUTO) env.TERMINAL_BROWSER_FRAMES = transport;
+  else if (sessionEnv.HERDR_PANE_ID && !sessionEnv.TERMINAL_BROWSER_FRAMES)
+    env.TERMINAL_BROWSER_FRAMES = "file";
+  // Herdr can forward one native file upload per scene. A whole-frame file
+  // keeps this fast path usable; a scene of many patches spills into inline
+  // base64 uploads and can starve the host terminal's input/render loop.
   return env;
 }
