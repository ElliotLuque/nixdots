 use super::*;
 
+#[cfg(test)]
+mod terminal_browser_tests {
+    use super::*;
+
+    #[test]
+    fn terminal_browser_menu_opens_beside_clicked_pane() {
+        let mut state = ClientShellState::new(ClientShellConfig::from_config(&Config::default()));
+        state.set_snapshot(Box::new(super::super::tests::snapshot()));
+        // Match the real handshake; an absent method list accepts everything.
+        state.set_endpoint_methods(Some(
+            crate::server::client_commands::supported_client_shell_method_names()
+                .iter()
+                .map(|method| (*method).to_owned())
+                .collect(),
+        ));
+        let menu = ClientContextMenuOverlay {
+            target: ClientContextMenuTarget::Pane {
+                pane_id: "clicked_pane".into(),
+                workspace_id: "clicked_workspace".into(),
+                source_pane_id: Some("focused_pane".into()),
+                has_manual_label: false,
+                right_click_passthrough: false,
+            },
+            x: 0,
+            y: 0,
+            highlighted: 0,
+        };
+        let index = menu.items().iter().position(|item| {
+            item.action == ClientContextMenuAction::OpenTerminalBrowser
+        }).expect("browser menu item");
+        state.overlay = Some(ClientShellOverlay::ContextMenu(menu));
+        let mut outcome = ClientShellInput::default();
+        state.activate_context_menu_item(index, &mut outcome);
+        let [ClientShellAction::Endpoint { request, .. }] = &outcome.actions[..] else {
+            panic!("expected one plugin pane request");
+        };
+        let crate::api::schema::Method::PluginPaneOpen(params) = &request.method else {
+            panic!("expected plugin.pane.open");
+        };
+        assert!(crate::server::client_commands::supports_client_shell_method(&request.method));
+        assert_eq!(params.plugin_id, "zenbu-labs.terminal-browser");
+        assert_eq!(params.entrypoint, "browser");
+        assert_eq!(params.target_pane_id.as_deref(), Some("clicked_pane"));
+        assert_eq!(params.workspace_id.as_deref(), Some("clicked_workspace"));
+        assert_eq!(params.direction, Some(crate::api::schema::SplitDirection::Right));
+    }
+}
