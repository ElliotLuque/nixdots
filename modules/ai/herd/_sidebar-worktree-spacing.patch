diff --git a/src/client/shell/tests/agents_worktrees_notifications.rs b/src/client/shell/tests/agents_worktrees_notifications.rs
--- a/src/client/shell/tests/agents_worktrees_notifications.rs
+++ b/src/client/shell/tests/agents_worktrees_notifications.rs
@@ -1,1 +1,46 @@
+#[test]
+fn worktree_row_gap_applies_to_parent_children_and_standalone_spaces() {
+    for gap in [0, 1, 2] {
+        let mut config = ClientShellConfig::from_config(&Config::default());
+        config.spaces.row_gap = gap;
+        let mut state = ClientShellState::new(config);
+        let mut snapshot = snapshot();
+        snapshot.workspaces[0].worktree = Some(ClientShellWorktree {
+            key: "repo".into(),
+            label: "repo".into(),
+            is_linked_worktree: false,
+        });
+        for number in 2..=4 {
+            let mut workspace = snapshot.workspaces[0].clone();
+            workspace.workspace_id = format!("ws_{number}");
+            workspace.active_tab_id = format!("tab_{number}");
+            workspace.number = number;
+            workspace.label = format!("feature-{number}");
+            workspace.focused = false;
+            workspace.worktree = (number < 4).then(|| ClientShellWorktree {
+                key: "repo".into(),
+                label: "repo".into(),
+                is_linked_worktree: true,
+            });
+            snapshot.workspaces.push(workspace);
+        }
+        state.set_snapshot(Box::new(snapshot));
+        state.set_pane_surface(surface());
+        let frame = state.compose(106, 40).expect("spaced worktree group");
+        let buffer = frame.to_ratatui_buffer().expect("frame buffer");
+        let hits = &state.hits.workspaces;
+        assert_eq!(hits.len(), 4);
+        assert!(hits[1].indented && hits[2].indented);
+        assert!(!hits[0].indented && !hits[3].indented);
+        for pair in hits.windows(2) {
+            assert_eq!(pair[1].rect.y, pair[0].rect.bottom() + gap);
+            for y in pair[0].rect.bottom()..pair[1].rect.y {
+                for x in pair[0].rect.x..pair[0].rect.right() {
+                    assert_eq!(buffer[(x, y)].symbol(), " ");
+                }
+            }
+        }
+    }
+}
